# Standard ignore rules for this repo's two runtimes (Python backend, Node frontend) plus
# local Docker volume data. Environment files and IDE-specific settings are excluded so
# secrets and personal editor config never get committed alongside the shared codebase.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build
dist/
build/

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/

# Docker
*.log

# OS
.DS_Store
Thumbs.db

# Local data
postgres_data/
minio_data/
