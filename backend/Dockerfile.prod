# Multi-stage production Dockerfile for FastAPI backend, deployed to Cloud Run.
# Stage 1: Build asyncpg (requires C compiler)
# Stage 2: Runtime with OCR dependencies (tesseract, poppler)

FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt


FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies for OCR
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    poppler-utils \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built wheels from builder stage
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir /wheels/* && rm -rf /wheels

COPY . .

# Cloud Run injects PORT; default to 8000 for local testing
ENV PORT=8000

EXPOSE ${PORT}

# Migrations are run as a separate step before deploy (see
# .github/workflows/deploy-backend.yml), not on container boot - Cloud Run can start
# multiple instances of the same revision concurrently, and concurrent
# `alembic upgrade head` runs would race.
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT}
